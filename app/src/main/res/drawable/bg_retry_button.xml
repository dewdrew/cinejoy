<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinejoy_red_dark" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinejoy_red" />
            <corners android:radius="6dp" />
            <stroke
                android:width="3dp"
                android:color="@color/cinejoy_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cinejoy_surface" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/cinejoy_red" />
        </shape>
    </item>
</selector>
